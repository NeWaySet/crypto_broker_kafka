classDiagram
    direction LR

    class WebApp {
        <<Boundary>>
        -KafkaProducer producer
        -deque messages
        -deque sensors
        +send_message()
        +send_sensor()
        +state()
        +consume_filtered()
    }

    class ProducerCli {
        <<Boundary>>
        +parse_user_message(raw)
        +sample_sensor_message()
        +connect_with_retry()
        +main()
    }

    class SensorGenerator {
        <<Boundary>>
        -string sensor_id
        -float interval_seconds
        +next_reading(previous_temperature, previous_humidity)
        +connect_with_retry()
        +main()
    }

    class CryptoGateway {
        <<Service>>
        -MessageTypeStrategy classifier
        -CryptoContainerFacade crypto
        +wait_for_decision(request_id)
        +output_topic_for(message_type)
        +main()
    }

    class MessageTypeStrategy {
        <<Strategy>>
        +detect(payload, source_topic) str
    }

    class CryptoContainerFacade {
        <<Facade>>
        -Fernet fernet
        +seal(payload, policy_decision, message_type, source_topic) dict
    }

    class PolicyDecisionPoint {
        <<PDP>>
        -dict policy
        +decide(request) dict
    }

    class SecureFilter {
        <<Service>>
        -CryptoContainerAdapter opener
        -Sanitizer sanitizer
        +validate(payload, message_type)
        +output_topic_for(message_type)
        +main()
    }

    class CryptoContainerAdapter {
        <<Adapter>>
        -Fernet fernet
        +open(container) dict
    }

    class Sanitizer {
        <<Security Filter>>
        -regex SCRIPT_RE
        +clean(payload) dict
    }

    class ConsumerViewer {
        <<Boundary>>
        +connect_with_retry()
        +main()
    }

    class MessagePayload {
        <<Data>>
        +string kind
        +string source
        +string timestamp
        +string message
        +float temperature
        +float humidity
    }

    class CryptoContainer {
        <<Data>>
        +string container_version
        +string message_type
        +string source_topic
        +string algorithm
        +string ciphertext
        +dict policy
        +string created_at
    }

    class KafkaTopics {
        <<Message Broker>>
        +messages.raw
        +messages.crypto
        +messages.filtered
        +sensors.raw
        +sensors.crypto
        +sensors.data.filtered
        +policy.requests
        +policy.decisions
    }

    WebApp ..> KafkaTopics : publish / consume
    ProducerCli ..> KafkaTopics : publish
    SensorGenerator ..> KafkaTopics : publish sensors.raw
    CryptoGateway ..> KafkaTopics : raw to crypto
    PolicyDecisionPoint ..> KafkaTopics : policy requests / decisions
    SecureFilter ..> KafkaTopics : crypto to filtered
    ConsumerViewer ..> KafkaTopics : consume filtered

    CryptoGateway *-- MessageTypeStrategy : uses
    CryptoGateway *-- CryptoContainerFacade : uses
    SecureFilter *-- CryptoContainerAdapter : uses
    SecureFilter *-- Sanitizer : uses

    WebApp ..> MessagePayload : creates
    ProducerCli ..> MessagePayload : creates
    SensorGenerator ..> MessagePayload : creates
    CryptoContainerFacade ..> CryptoContainer : creates
    CryptoContainerAdapter ..> CryptoContainer : opens
