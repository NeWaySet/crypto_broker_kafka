{
  "version": "1.0",
  "default_decision": "deny",
  "allowed_sources": ["producer:chat", "producer:sensor", "producer:/sample", "web:chat", "sensor-generator"],
  "allowed_message_types": ["chat-message", "sensor-data"],
  "limits": {
    "max_text_length": 240,
    "temperature_min": -20.0,
    "temperature_max": 50.0,
    "humidity_min": 0.0,
    "humidity_max": 100.0
  }
}
