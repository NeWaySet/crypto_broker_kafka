{
  "version": "1.0",
  "default_decision": "deny",
  "allowed_sources": ["producer:json", "producer:text", "producer:/sample"],
  "allowed_message_types": ["sensor-data", "text-message"],
  "limits": {
    "max_text_length": 240,
    "temperature_min": -20.0,
    "temperature_max": 50.0,
    "humidity_min": 0.0,
    "humidity_max": 100.0
  }
}
