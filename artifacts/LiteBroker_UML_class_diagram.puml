@startuml
skinparam class {
  BackgroundColor #8EF59A
  BorderColor #111111
  ArrowColor #111111
}
skinparam shadowing false
skinparam classAttributeIconSize 0

title LiteBroker UML class diagram

class LiteBrokerUI {
  +token
  +selectedPeer
  +messages
  --
  +selectPeer()
  +sendMessage()
  +showContainer()
}

class ApiServer {
  +routes
  +currentUser
  +policy
  --
  +login()
  +register()
  +postMessage()
  +getSensors()
  +metrics()
}

class CryptoService {
  +algorithm
  +iv
  +authTag
  --
  +encryptMessage()
  +decryptMessage()
  +cryptoKey()
}

class CryptoContainer {
  +version
  +algorithm
  +ciphertext
  +metadata
  --
  +verifyAuthTag()
}

class Database {
  +users
  +sessions
  +messages
  +sensor_samples
  --
  +openDb()
  +seedUsers()
  +userMessages()
}

class KafkaProducer {
  +brokers
  +chatTopicPrefix
  +sensorTopic
  --
  +publishKafka()
  +chatTopic()
}

class SensorGenerator {
  +intervalMs
  +temperature
  +humidity
  +pressure
  --
  +createSample()
  +startGenerator()
}

class GrafanaMonitor {
  +dashboards
  +datasources
  +logs
  --
  +showSensors()
  +showContainers()
}

LiteBrokerUI --> ApiServer : HTTP API
ApiServer o-- CryptoService : uses
CryptoService --> CryptoContainer : creates
ApiServer o-- Database : stores
ApiServer o-- KafkaProducer : publishes chat topic
SensorGenerator --> Database : writes
SensorGenerator --> KafkaProducer : sensor topic
KafkaProducer --> GrafanaMonitor : logs / metrics
Database --> GrafanaMonitor : sensor samples

@enduml
