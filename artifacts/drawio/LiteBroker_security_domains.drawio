<mxfile host="app.diagrams.net" modified="2026-05-29T00:00:00.000Z" agent="Codex" version="24.0.0" type="device">
  <diagram id="LiteBroker_security_domains" name="LiteBroker security domains">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        
        <mxCell id="tableTitle" value="Таблица доменов безопасности LiteBroker" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ffffff;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="20" y="30" width="640" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="d1" value="1. Browser UI&lt;br&gt;&lt;b&gt;недоверенный&lt;/b&gt;&lt;br&gt;принимает пользовательский ввод; может отправить некорректные или вредоносные запросы&lt;br&gt;&lt;i&gt;все запросы проходят через API&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="20" y="80" width="640" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="d2" value="2. LiteBroker API&lt;br&gt;&lt;b&gt;доверенный&lt;/b&gt;&lt;br&gt;единственная точка принятия решений: авторизация, валидация, маршрутизация&lt;br&gt;&lt;i&gt;повышает целостность данных&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="20" y="164" width="640" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="d3" value="3. Auth/Session&lt;br&gt;&lt;b&gt;доверенный&lt;/b&gt;&lt;br&gt;проверяет токены и не отдаёт password_hash клиенту&lt;br&gt;&lt;i&gt;обязателен для всех бизнес-endpoint&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="20" y="248" width="640" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="d4" value="4. CryptoService&lt;br&gt;&lt;b&gt;доверенный&lt;/b&gt;&lt;br&gt;создаёт AES-256-GCM криптоконтейнеры и проверяет authTag&lt;br&gt;&lt;i&gt;критичный компонент защиты&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="20" y="332" width="640" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="d5" value="5. PostgreSQL&lt;br&gt;&lt;b&gt;ограниченно доверенный&lt;/b&gt;&lt;br&gt;хранилище может быть прочитано администратором, поэтому payload хранится зашифрованным&lt;br&gt;&lt;i&gt;не хранит открытый текст сообщений&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="20" y="416" width="640" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="d6" value="6. Kafka Broker&lt;br&gt;&lt;b&gt;ограниченно доверенный&lt;/b&gt;&lt;br&gt;транспортный канал может быть просмотрен, но сообщения передаются как контейнеры&lt;br&gt;&lt;i&gt;разделяет chat topic и sensor topic&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="20" y="500" width="640" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="d7" value="7. SensorGenerator&lt;br&gt;&lt;b&gt;доверенный&lt;/b&gt;&lt;br&gt;генерирует учебные замеры без пользовательского ввода&lt;br&gt;&lt;i&gt;замеры также шифруются в БД&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="20" y="584" width="640" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="d8" value="8. Prometheus/Loki/Grafana&lt;br&gt;&lt;b&gt;недоверенный read-only&lt;/b&gt;&lt;br&gt;модуль наблюдаемости не должен менять бизнес-данные&lt;br&gt;&lt;i&gt;используется для контроля и защиты&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="20" y="668" width="640" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="d9" value="9. Docker Network&lt;br&gt;&lt;b&gt;ограниченно доверенный&lt;/b&gt;&lt;br&gt;изолирует контейнеры, но не заменяет криптографическую защиту&lt;br&gt;&lt;i&gt;задаёт границы взаимодействия&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="20" y="752" width="640" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="d10" value="10. Operator/Admin&lt;br&gt;&lt;b&gt;доверенный&lt;/b&gt;&lt;br&gt;имеет доступ к запуску стенда и переменным окружения&lt;br&gt;&lt;i&gt;для промышленной версии нужны secrets&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="20" y="836" width="640" height="84" as="geometry"/>
        </mxCell>
        <mxCell id="trusted" value="Модуль доверенной логики" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="740" y="40" width="360" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="infra" value="Инфраструктура и периферия" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1160" y="40" width="360" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="api" value="LiteBroker API&lt;br&gt;DL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9f8d6;strokeColor=#3bae3b;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="790" y="130" width="220" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="auth" value="Auth/Session&lt;br&gt;DL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9f8d6;strokeColor=#3bae3b;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="790" y="250" width="220" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="crypto" value="CryptoService&lt;br&gt;DL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9f8d6;strokeColor=#3bae3b;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="790" y="370" width="220" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="sensor" value="SensorGenerator&lt;br&gt;DL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d9f8d6;strokeColor=#3bae3b;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="790" y="490" width="220" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="browser" value="Browser UI&lt;br&gt;UN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe1e1;strokeColor=#d64a4a;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1210" y="130" width="220" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="kafka" value="Kafka Broker&lt;br&gt;LT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff0c2;strokeColor=#d69a00;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1210" y="250" width="220" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="postgres" value="PostgreSQL&lt;br&gt;LT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff0c2;strokeColor=#d69a00;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1210" y="370" width="220" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="grafana" value="Grafana/Loki&lt;br&gt;RO" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e6ecff;strokeColor=#5a6fdb;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1210" y="490" width="220" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="e1" value="HTTP input" style="endArrow=block;html=1;rounded=0;strokeColor=#d64a4a;fontColor=#d64a4a;" edge="1" parent="1" source="browser" target="api">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="token" style="endArrow=block;html=1;rounded=0;strokeColor=#3bae3b;fontColor=#3bae3b;" edge="1" parent="1" source="api" target="auth">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" value="policy" style="endArrow=block;html=1;rounded=0;strokeColor=#3bae3b;fontColor=#3bae3b;" edge="1" parent="1" source="auth" target="crypto">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" value="encrypted JSONB" style="endArrow=block;html=1;rounded=0;strokeColor=#3bae3b;fontColor=#3bae3b;" edge="1" parent="1" source="crypto" target="postgres">
          <mxGeometry relative="1" as="geometry"/>
