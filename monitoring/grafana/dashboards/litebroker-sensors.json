{
  "uid": "litebroker-sensors",
  "title": "LiteBroker: показания датчиков",
  "tags": ["cryptobroker", "litebroker", "sensors"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "panels": [
    {
      "type": "timeseries",
      "title": "Температура, °C",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "litebroker_sensor_temperature_celsius", "legendFormat": "temperature" }]
    },
    {
      "type": "timeseries",
      "title": "Влажность, %",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "litebroker_sensor_humidity_percent", "legendFormat": "humidity" }]
    },
    {
      "type": "stat",
      "title": "Давление, hPa",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 8 },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "litebroker_sensor_pressure_hpa", "legendFormat": "pressure" }]
    },
    {
      "type": "stat",
      "title": "Всего замеров",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 8 },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "litebroker_sensor_samples_total", "legendFormat": "samples" }]
    },
    {
      "type": "stat",
      "title": "Kafka",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 8 },
      "targets": [{ "datasource": { "type": "prometheus", "uid": "Prometheus" }, "expr": "litebroker_kafka_ready", "legendFormat": "ready" }]
    }
  ]
}
